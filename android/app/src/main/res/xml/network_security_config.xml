<?xml version="1.0" encoding="utf-8"?>
<!--
  The arm/drive/cam/sensor ESP32 modules on your local network serve plain
  HTTP + WS, not HTTPS, so cleartext traffic must stay permitted for this
  app to talk to them (armcam.local, techaurix-drive.local, 192.168.x.x…).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
